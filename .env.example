# Copy to .env for local development: `cp .env.example .env`
# .env is gitignored and must never be committed.

# Required. Google Gemini API key. The router refuses to start without it.
GEMINI_API_KEY=

# Optional. Application log level: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# Optional. SQLite database path. Defaults to ./data/router.db.
# The parent directory is created automatically; WAL mode is enforced at startup.
ROUTER_DB_PATH=

# Optional. Explicit config.yaml location. Defaults to ./config.yaml.
ROUTER_CONFIG_PATH=
