# Copy to .env for local development: `cp .env.example .env`
# .env is gitignored and must never be committed.

# Required. Google Gemini API key. The router refuses to start without it.
GEMINI_API_KEY=

# Optional. Application log level: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# Optional. SQLite database path. Defaults to ./data/router.db.
# The parent directory is created automatically; WAL mode is enforced at startup.
ROUTER_DB_PATH=

# Optional. Explicit config.yaml location. Defaults to ./config.yaml.
ROUTER_CONFIG_PATH=

# -----------------------------------------------------------------------------
# You do not need this file for GEMINI_API_KEY.
#
# Docker Compose resolves an exported shell variable before falling back to
# .env, so exporting the key in your shell is enough:
#
#   export GEMINI_API_KEY=...        # or add it to ~/.zshrc
#   docker compose up -d
#
# That keeps the secret out of any file on disk. Use this file only for local
# overrides, or if you would rather not export the key in every shell.
# -----------------------------------------------------------------------------
GEMINI_API_KEY=

# Optional. Verify the containerised stack end to end:
#   docker compose up -d
#   curl -s localhost:8000/v1/chat/completions -H 'content-type: application/json' \
#     -d '{"model":"google/gemini-3.5-flash-lite","messages":[{"role":"user","content":"hi"}]}'
#   curl -s localhost:8000/health
# The router refuses to start without GEMINI_API_KEY (spec 6, Scenario 2).
