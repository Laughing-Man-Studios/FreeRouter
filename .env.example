# Copy to .env for local development: `cp .env.example .env`
# .env is gitignored and must never be committed.
#
# Key material lives here, one variable per (provider, alias) slot. The variable
# name is DERIVED by ADR-0003 as <PROVIDER>_KEY_<ALIAS>, uppercase -- it is
# never read from config.yaml, because a configurable variable name would let
# config.yaml point the router at any environment variable on the host.
#
# A model declares its slots in config.yaml via `key_aliases`. Omitting the
# field means one key, aliased "primary". Declaring an alias with no matching
# variable below aborts startup, naming the alias and the variable.

# Required if a Google model is configured. Gemini API key, single credential.
GOOGLE_KEY_PRIMARY=

# Optional. A second Google credential. Only declare `key_aliases:
# ["primary", "secondary"]` for the model if this is set.
#
#   Worth understanding before enabling: Google's rate limits apply per
#   PROJECT, not per API key, so a second key draws on the same quota bucket.
#   It provides credential redundancy -- a revoked key does not stop the
#   router -- and adds no capacity. CONSTITUTION 6.1 caps Google at two.
GOOGLE_KEY_SECONDARY=

# Required if a Mistral model is configured.
MISTRAL_KEY_PRIMARY=

# Optional log level: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO

# Optional. SQLite database path. Defaults to ./data/router.db.
# The parent directory is created automatically; WAL mode is enforced at startup.
ROUTER_DB_PATH=

# Optional. Explicit config.yaml location. Defaults to ./config.yaml.
ROUTER_CONFIG_PATH=

# -----------------------------------------------------------------------------
# You do not need this file for key material.
#
# Docker Compose resolves an exported shell variable before falling back to
# .env, so exporting the key in your shell is enough:
#
#   export GOOGLE_KEY_PRIMARY=...    # or add it to ~/.zshrc
#   docker compose up -d
#
# That keeps the secret out of any file on disk. Use the empty assignments above
# only as a local override; there is deliberately no second declaration here,
# since a later assignment in a .env file wins and the duplicate would imply
# a key is required in this file when it is not.
# -----------------------------------------------------------------------------

# Optional. Verify the containerised stack end to end:
#   docker compose up -d
#   curl -s localhost:8000/v1/chat/completions -H 'content-type: application/json' \
#     -d '{"model":"google/gemini-3.5-flash-lite","messages":[{"role":"user","content":"hi"}]}'
#   curl -s localhost:8000/health
#
# The router refuses to start without a credential for every declared slot
# (spec 6, Scenario 2).
